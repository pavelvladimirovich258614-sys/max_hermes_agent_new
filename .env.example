# ============================================================
# MAX Hermes Agent — Environment Variables
# ============================================================
# Copy this file to ~/.hermes/.env and fill in real values.
# NEVER commit real values to any repository.
# ============================================================

# MAX bot token from MAX developer console / bot settings
MAX_BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE

# Comma-separated MAX user IDs allowed to control Hermes
MAX_ALLOWED_USERS=YOUR_MAX_USER_ID

# Never enable this in production
MAX_ALLOW_ALL_USERS=0

# Long polling timeout (seconds)
MAX_POLLING_TIMEOUT=30

# Show progress/tool messages in MAX as append messages
MAX_PROGRESS_APPEND=1

# Optional: MAX home route for future cron delivery
# MAX_HOME_CHANNEL=user:YOUR_MAX_USER_ID
