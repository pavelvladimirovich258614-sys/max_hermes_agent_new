# ============================================================
# MAX Hermes Agent — переменные окружения
# ============================================================
# Скопируйте этот файл в ~/.hermes/.env и впишите реальные значения.
# НИКОГДА не коммитьте реальные значения ни в какой репозиторий.
# ============================================================

# Токен бота MAX из консоли разработчика / настроек бота
MAX_BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE

# Список MAX user ID через запятую — кому разрешено управлять Hermes
MAX_ALLOWED_USERS=YOUR_MAX_USER_ID

# Никогда не включайте это в продакшене
MAX_ALLOW_ALL_USERS=0

# Таймаут long polling (секунды)
MAX_POLLING_TIMEOUT=30

# Показывать прогресс/сообщения инструментов в MAX как append-сообщения
MAX_PROGRESS_APPEND=1

# Опционально: домашний маршрут MAX для будущей доставки cron
# MAX_HOME_CHANNEL=user:YOUR_MAX_USER_ID
